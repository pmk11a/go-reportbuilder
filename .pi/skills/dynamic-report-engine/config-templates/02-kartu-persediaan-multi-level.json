{
  "report_name": "Kartu Persediaan Multi-Level",
  "kode_menu": "RPT-KPML",
  "description": "Laporan kartu persediaan dengan 4 level grouping: Warehouse → Category → Item → Batch",
  
  "dbmasterlaporan": {
    "KODEMENU": "RPT-KPML",
    "nama_laporan": "Kartu Persediaan",
    "deskripsi": "Movement barang per warehouse, kategori, item, dan batch",
    "status_aktif": 1,
    "footer_bands": {
      "bands": {
        "summary": {
          "footer_table": true,
          "chgb_panel": {
            "enabled": false
          }
        }
      }
    }
  },
  
  "dbparameterlaporan": [
    {
      "nama_filter": "TanggalDari",
      "label": "Tanggal Awal",
      "tipe_input": "date",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 1,
      "konfigurasi": null
    },
    {
      "nama_filter": "TanggalSampai",
      "label": "Tanggal Akhir",
      "tipe_input": "date",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 2,
      "konfigurasi": null
    },
    {
      "nama_filter": "KodeWarehouse",
      "label": "Gudang",
      "tipe_input": "browse",
      "wajib_isi": 0,
      "nilai_default": null,
      "kode_browse": "BROWSE_WAREHOUSE",
      "posisi": 3,
      "konfigurasi": null
    }
  ],
  
  "dbquerylaporan": [
    {
      "nama_dataset": "kartu_data",
      "urutan": 1,
      "query_sumber_data": "SELECT w.KodeWarehouse, w.NamaWarehouse, c.KodeCategory, c.NamaCategory, i.KodeItem, i.NamaItem, b.KodeBatch, t.Tanggal, t.JenisTransaksi, t.Masuk, t.Keluar FROM transaksipersediaan t JOIN item i ON t.KodeItem=i.KodeItem JOIN category c ON i.KodeCategory=c.KodeCategory JOIN warehouse w ON t.KodeWarehouse=w.KodeWarehouse JOIN batch b ON t.KodeBatch=b.KodeBatch WHERE t.Tanggal BETWEEN @TanggalDari AND @TanggalSampai {{AND t.KodeWarehouse=@KodeWarehouse}} ORDER BY w.KodeWarehouse, c.KodeCategory, i.KodeItem, b.KodeBatch, t.Tanggal",
      "config_json": {
        "display_role": "detail",
        "static_params": {
          "@TanggalDari": "",
          "@TanggalSampai": "",
          "@KodeWarehouse": ""
        }
      }
    }
  ],
  
  "dbkolomlaporan": [
    {"nama_dataset": "kartu_data", "nama_kolom": "NamaWarehouse", "label_tampil": "Gudang", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 1},
    {"nama_dataset": "kartu_data", "nama_kolom": "NamaCategory", "label_tampil": "Kategori", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 2},
    {"nama_dataset": "kartu_data", "nama_kolom": "NamaItem", "label_tampil": "Item", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 3},
    {"nama_dataset": "kartu_data", "nama_kolom": "KodeBatch", "label_tampil": "Batch", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 4},
    {"nama_dataset": "kartu_data", "nama_kolom": "Tanggal", "label_tampil": "Tanggal", "format_type": "date", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 5},
    {"nama_dataset": "kartu_data", "nama_kolom": "JenisTransaksi", "label_tampil": "Jenis", "format_type": "text", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 6},
    {"nama_dataset": "kartu_data", "nama_kolom": "Masuk", "label_tampil": "Masuk", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 7},
    {"nama_dataset": "kartu_data", "nama_kolom": "Keluar", "label_tampil": "Keluar", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 8},
    {"nama_dataset": "kartu_data", "nama_kolom": "Balance", "label_tampil": "Saldo", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 9}
  ],
  
