{
  "report_name": "Multi-Currency Report",
  "kode_menu": "RPT-MC",
  "description": "Laporan multi mata uang dengan konversi dan display dalam beberapa currency",
  
  "dbmasterlaporan": {
    "KODEMENU": "RPT-MC",
    "nama_laporan": "Multi-Currency Report",
    "deskripsi": "Laporan dengan display dalam USD, EUR, dan IDR",
    "status_aktif": 1,
    "footer_bands": {
      "bands": {
        "summary": {
          "footer_table": true,
          "chgb_panel": {
            "enabled": false
          }
        }
      }
    }
  },
  
  "dbparameterlaporan": [
    {
      "nama_filter": "TanggalDari",
      "label": "Tanggal Dari",
      "tipe_input": "date",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 1,
      "konfigurasi": null
    },
    {
      "nama_filter": "TanggalSampai",
      "label": "Tanggal Sampai",
      "tipe_input": "date",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 2,
      "konfigurasi": null
    },
    {
      "nama_filter": "Currency",
      "label": "Currency Display",
      "tipe_input": "dropdown",
      "wajib_isi": 0,
      "nilai_default": "USD",
      "posisi": 3,
      "konfigurasi": {
        "options": ["USD", "EUR", "IDR"]
      }
    }
  ],
  
  "dbquerylaporan": [
    {
      "nama_dataset": "multi_curr_data",
      "urutan": 1,
      "query_sumber_data": "SELECT t.Tanggal, c.KodeCurrency, c.NamaCurrency, t.AmountOriginal, t.AmountConverted, er.Rate FROM transaksi t JOIN currency c ON t.KodeCurrency=c.KodeCurrency JOIN exchangerate er ON c.KodeCurrency=er.KodeCurrency AND er.Tanggal=t.Tanggal WHERE t.Tanggal BETWEEN @TanggalDari AND @TanggalSampai ORDER BY t.Tanggal, c.KodeCurrency",
      "config_json": {
        "display_role": "detail",
        "static_params": {
          "@TanggalDari": "",
          "@TanggalSampai": ""
        },
        "multi_currency": {
          "enabled": true,
          "base_currency": "IDR",
          "display_currencies": ["USD", "EUR", "IDR"],
          "conversion_rates": {
            "USD": 15000,
            "EUR": 16500
          }
        }
      }
    }
  ],
  
  "dbkolomlaporan": [
    {"nama_dataset": "multi_curr_data", "nama_kolom": "Tanggal", "label_tampil": "Tanggal", "format_type": "date", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 1},
    {"nama_dataset": "multi_curr_data", "nama_kolom": "NamaCurrency", "label_tampil": "Mata Uang", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 2},
    {"nama_dataset": "multi_curr_data", "nama_kolom": "AmountOriginal", "label_tampil": "Jumlah Asli", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 3},
    {"nama_dataset": "multi_curr_data", "nama_kolom": "AmountConverted", "label_tampil": "Jumlah Konversi", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 4},
    {"nama_dataset": "multi_curr_data", "nama_kolom": "Rate", "label_tampil": "Rate", "format_type": "number", "alignment": "right", "is_summable": false, "is_visible": true, "urutan_tampil": 5}
  ],
  
  "dbgrouplaporan": [
    {
      "id_laporan": "RPT-MC",
      "group_level": 1,
      "group_field": "KodeCurrency",
      "field_value": "currency",
      "label": "Mata Uang",
      "sort_order": 1,
      "show_subtotal": 1,
      "special_handling": "multi-currency",
      "style_config": {
        "font_weight": "bold",
        "background": "purple-50"
      },
      "config_json": {
        "field_name": "KodeCurrency",
        "label_mapping": {
          "USD": "US Dollar",
          "EUR": "Euro",
          "IDR": "Indonesian Rupiah"
        },
        "show_subtotal": true,
        "currency_converted": true
      }
    }
  ],
  
  "frontend_config": {
    "rendering_mode": "multi-currency",
    "show_group_headers": true,
    "show_subtotals": true,
    "currency_display": "all",
    "conversion_enabled": true
  }
}
