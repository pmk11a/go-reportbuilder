{
  "report_name": "Hierarchical Account Report",
  "kode_menu": "RPT-HIER",
  "description": "Laporan akun dengan hierarki bertingkat (coa level 1-5)",
  
  "dbmasterlaporan": {
    "KODEMENU": "RPT-HIER",
    "nama_laporan": "Hierarchical Chart of Accounts",
    "deskripsi": "CoA dengan hierarki 5 level",
    "status_aktif": 1,
    "footer_bands": {
      "bands": {
        "summary": {
          "footer_table": false,
          "chgb_panel": {
            "enabled": false
          }
        }
      }
    }
  },
  
  "dbparameterlaporan": [
    {
      "nama_filter": "StatusAkun",
      "label": "Status Akun",
      "tipe_input": "dropdown",
      "wajib_isi": 0,
      "nilai_default": "A",
      "posisi": 1,
      "konfigurasi": {
        "options": ["A", "I"]
      }
    },
    {
      "nama_filter": "LevelMin",
      "label": "Level Minimum",
      "tipe_input": "number",
      "wajib_isi": 0,
      "nilai_default": 1,
      "posisi": 2,
      "konfigurasi": null
    }
  ],
  
  "dbquerylaporan": [
    {
      "nama_dataset": "coa_data",
      "urutan": 1,
      "query_sumber_data": "SELECT Kdaccount, NamaAkun, Kdgroup, Level, SaldoNormal, COALESCE(Saldo,0) AS Saldo FROM akun a LEFT JOIN saldo s ON a.Kdaccount=s.Kdaccount AND s.Tahun=@Tahun WHERE a.Level >= @LevelMin ORDER BY a.Kdaccount",
      "config_json": {
        "display_role": "detail",
        "static_params": {
          "@Tahun": "2024"
        },
        "hierarchical": {
          "enabled": true,
          "level_field": "Level",
          "parent_field": "Kdgroup",
          "max_depth": 5
        }
      }
    }
  ],
  
  "dbkolomlaporan": [
    {"nama_dataset": "coa_data", "nama_kolom": "Kdaccount", "label_tampil": "Kode Akun", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 1},
    {"nama_dataset": "coa_data", "nama_kolom": "NamaAkun", "label_tampil": "Nama Akun", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 2},
    {"nama_dataset": "coa_data", "nama_kolom": "Level", "label_tampil": "Level", "format_type": "number", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 3},
    {"nama_dataset": "coa_data", "nama_kolom": "Saldo", "label_tampil": "Saldo", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 4}
  ],
  
  "dbgrouplaporan": [
