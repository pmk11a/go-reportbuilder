{
  "report_name": "Laporan Aging dengan Running Balance",
  "kode_menu": "RPT-AGING-RB",
  "description": "Laporan aging piutang dengan perhitungan running balance per grup pelanggan",
  
  "dbmasterlaporan": {
    "KODEMENU": "RPT-AGING-RB",
    "nama_laporan": "Aging Piutang - Running Balance",
    "deskripsi": "Aging piutang dengan running balance calculation per customer",
    "status_aktif": 1,
    "footer_bands": {
      "bands": {
        "summary": {
          "footer_table": true,
          "chgb_panel": {
            "enabled": false
          }
        }
      }
    }
  },
  
  "dbparameterlaporan": [
    {
      "nama_filter": "PeriodeSampai",
      "label": "Periode Sampai",
      "tipe_input": "date",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 1,
      "konfigurasi": null
    },
    {
      "nama_filter": "CustomerGroup",
      "label": "Grup Pelanggan",
      "tipe_input": "browse",
      "wajib_isi": 0,
      "nilai_default": null,
      "kode_browse": "BROWSE_CUSTOMER_GROUP",
      "posisi": 2,
      "konfigurasi": null
    }
  ],
  
  "dbquerylaporan": [
    {
      "nama_dataset": "aging_data",
      "urutan": 1,
      "query_sumber_data": "SELECT c.KodeCustomer, c.NamaCustomer, c.Kdgroup, inv.NoInvoice, inv.Tanggal, inv.Total, inv.Saldo, DATEDIFF(@PeriodeSampai, inv.Tanggal) AS AgeDays FROM invoice inv JOIN customer c ON inv.KodeCustomer=c.KodeCustomer WHERE inv.Saldo > 0 {{AND c.Kdgroup=@CustomerGroup}} ORDER BY c.Kdgroup, c.KodeCustomer, inv.Tanggal",
      "config_json": {
        "display_role": "detail",
        "static_params": {
          "@PeriodeSampai": "",
          "@CustomerGroup": ""
        },
        "running_balance": {
          "enabled": true,
          "balance_column": "Saldo",
          "start_marker": "BEGIN",
          "marker_column": "Marker",
          "group_by": "KodeCustomer"
        }
      }
    }
  ],
  
  "dbkolomlaporan": [
    {"nama_dataset": "aging_data", "nama_kolom": "NamaCustomer", "label_tampil": "Pelanggan", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 1},
    {"nama_dataset": "aging_data", "nama_kolom": "NoInvoice", "label_tampil": "No. Invoice", "format_type": "text", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 2},
    {"nama_dataset": "aging_data", "nama_kolom": "Tanggal", "label_tampil": "Tanggal", "format_type": "date", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 3},
    {"nama_dataset": "aging_data", "nama_kolom": "Total", "label_tampil": "Total", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 4},
    {"nama_dataset": "aging_data", "nama_kolom": "Saldo", "label_tampil": "Saldo", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 5},
    {"nama_dataset": "aging_data", "nama_kolom": "RunningBalance", "label_tampil": "Running Bal", "format_type": "currency", "alignment": "right", "is_summable": false, "is_visible": true, "urutan_tampil": 6},
    {"nama_dataset": "aging_data", "nama_kolom": "AgeDays", "label_tampil": "Umur (Hari)", "format_type": "number", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 7}
  ],
  
  "dbgrouplaporan": [
    {
      "id_laporan": "RPT-AGING-RB",
      "group_level": 1,
      "group_field": "KodeCustomer",
      "field_value": "customer",
      "label": "Pelanggan",
      "sort_order": 1,
      "show_subtotal": 1,
      "special_handling": "running-balance",
      "style_config": {
        "font_weight": "bold",
        "background": "secondary-50"
      },
      "config_json": {
        "field_name": "KodeCustomer",
        "running_total": true,
        "balance_column": "Saldo",
        "show_subtotal": true,
        "show_running_balance": true
      }
    }
  ],
  
  "frontend_config": {
    "rendering_mode": "running-balance",
    "show_group_headers": true,
    "show_subtotals": true,
    "show_running_balance": true,
    "balance_column": "Saldo",
    "running_balance_enabled": true
  }
}
