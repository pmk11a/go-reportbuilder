{
  "report_name": "Warehouse Movement Detail",
  "kode_menu": "RPT-WMD",
  "description": "Laporan pergerakan barang warehouse dengan grouping multi-level dan special handling",
  
  "dbmasterlaporan": {
    "KODEMENU": "RPT-WMD",
    "nama_laporan": "Warehouse Movement Detail",
    "deskripsi": "Detail movement barang per warehouse dengan sub-total per kategori",
    "status_aktif": 1,
    "footer_bands": {
      "bands": {
        "summary": {
          "footer_table": true,
          "rows": [
            {"label": "Total Masuk", "field": "total_masuk", "format": "number"},
            {"label": "Total Keluar", "field": "total_keluar", "format": "number"},
            {"label": "Net Movement", "field": "net_movement", "format": "number"}
          ],
          "chgb_panel": {
            "enabled": false
          }
        }
      }
    }
  },
  
  "dbparameterlaporan": [
    {
      "nama_filter": "TanggalDari",
      "label": "Tanggal Dari",
      "tipe_input": "date",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 1,
      "konfigurasi": null
    },
    {
      "nama_filter": "TanggalSampai",
      "label": "Tanggal Sampai",
      "tipe_input": "date",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 2,
      "konfigurasi": null
    },
    {
      "nama_filter": "Warehouse",
      "label": "Warehouse",
      "tipe_input": "browse",
      "wajib_isi": 0,
      "nilai_default": null,
      "kode_browse": "BROWSE_WAREHOUSE",
      "posisi": 3,
      "konfigurasi": null
    }
  ],
  
  "dbquerylaporan": [
    {
      "nama_dataset": "movement_data",
      "urutan": 1,
      "query_sumber_data": "SELECT w.KodeWarehouse, w.NamaWarehouse, c.KodeCategory, c.NamaCategory, i.KodeItem, i.NamaItem, t.Tanggal, t.JenisTransaksi, t.Quantity, t.Satuan FROM warehouse w JOIN category c ON w.KodeCategory=c.KodeCategory JOIN item i ON c.KodeCategory=i.KodeCategory JOIN movement t ON i.KodeItem=t.KodeItem WHERE t.Tanggal BETWEEN @TanggalDari AND @TanggalSampai {{AND t.KodeWarehouse=@Warehouse}} ORDER BY w.KodeWarehouse, c.KodeCategory, i.KodeItem, t.Tanggal",
      "config_json": {
        "display_role": "detail",
        "static_params": {
          "@TanggalDari": "",
          "@TanggalSampai": "",
          "@Warehouse": ""
        },
        "special_features": {
          "virtual_columns": [
            {
              "nama_kolom": "InOut",
              "expression": "CASE WHEN JenisTransaksi='IN' THEN '+' ELSE '-' END",
              "is_formula": true
            }
          ]
        }
      }
    }
  ],
  
  "dbkolomlaporan": [
    {"nama_dataset": "movement_data", "nama_kolom": "NamaWarehouse", "label_tampil": "Warehouse", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 1},
    {"nama_dataset": "movement_data", "nama_kolom": "NamaCategory", "label_tampil": "Kategori", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 2},
    {"nama_dataset": "movement_data", "nama_kolom": "NamaItem", "label_tampil": "Item", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 3},
    {"nama_dataset": "movement_data", "nama_kolom": "Tanggal", "label_tampil": "Tanggal", "format_type": "date", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 4},
    {"nama_dataset": "movement_data", "nama_kolom": "JenisTransaksi", "label_tampil": "Jenis", "format_type": "text", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 5},
    {"nama_dataset": "movement_data", "nama_kolom": "Quantity", "label_tampil": "Qty", "format_type": "number", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 6},
    {"nama_dataset": "movement_data", "nama_kolom": "Satuan", "label_tampil": "Satuan", "format_type": "text", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 7}
  ],
  
  "dbgrouplaporan": [
    {
      "id_laporan": "RPT-WMD",
      "group_level": 1,
      "group_field": "KodeWarehouse",
      "field_value": "warehouse",
      "label": "Warehouse",
      "sort_order": 1,
      "show_subtotal": 1,
      "special_handling": "default",
      "style_config": {
        "font_weight": "bold",
        "background": "secondary-50"
      },
      "config_json": {
        "field_name": "KodeWarehouse",
        "label_mapping": {
          "WH01": "Gudang Utama",
          "WH02": "Gudang Cabang 1",
          "WH03": "Gudang Cabang 2"
        },
        "show_subtotal": true
      }
    },
    {
      "id_laporan": "RPT-WMD",
      "group_level": 2,
      "group_field": "KodeCategory",
      "field_value": "category",
      "label": "Kategori",
      "sort_order": 2,
      "show_subtotal": 1,
      "special_handling": "default",
      "style_config": {
        "font_weight": "medium",
        "background": "green-50",
        "padding_left": 16
      },
      "config_json": {
        "field_name": "KodeCategory",
        "show_subtotal": true
      }
    },
    {
      "id_laporan": "RPT-WMD",
      "group_level": 3,
      "group_field": "KodeItem",
      "field_value": "item",
      "label": "Item",
      "sort_order": 3,
      "show_subtotal": 0,
      "special_handling": "default",
      "style_config": {
        "font_weight": "normal",
        "padding_left": 32
      },
      "config_json": {
        "field_name": "KodeItem",
        "show_subtotal": false
      }
    }
  ],
  
  "frontend_config": {
    "rendering_mode": "n-level-grouping",
    "show_group_headers": true,
    "show_subtotals": true,
    "show_grand_total": true,
    "max_level": 3
  }
}
