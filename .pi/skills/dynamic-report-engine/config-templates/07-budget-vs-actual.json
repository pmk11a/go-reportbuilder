{
  "report_name": "Budget vs Actual",
  "kode_menu": "RPT-BVA",
  "description": "Laporan perbandingan budget vs actual dengan conditional formatting",
  
  "dbmasterlaporan": {
    "KODEMENU": "RPT-BVA",
    "nama_laporan": "Budget vs Actual",
    "deskripsi": "Perbandingan anggaran vs realisasi dengan analisis varian",
    "status_aktif": 1,
    "footer_bands": {
      "bands": {
        "summary": {
          "footer_table": true,
          "chgb_panel": {
            "enabled": true,
            "rows": [
              {"label": "Total Budget", "current_field": "total_budget"},
              {"label": "Total Actual", "current_field": "total_actual"},
              {"label": "Variance", "current_field": "variance", "highlight_diff": true},
              {"label": "% Variance", "current_field": "variance_percent", "format": "percent"}
            ]
          }
        }
      }
    }
  },
  
  "dbparameterlaporan": [
    {
      "nama_filter": "Tahun",
      "label": "Tahun",
      "tipe_input": "number",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 1,
      "konfigurasi": null
    },
    {
      "nama_filter": "BudgetType",
      "label": "Tipe Budget",
      "tipe_input": "dropdown",
      "wajib_isi": 0,
      "nilai_default": "Annual",
      "posisi": 2,
      "konfigurasi": {
        "options": ["Annual", "Quarterly", "Monthly"]
      }
    }
  ],
  
  "dbquerylaporan": [
    {
      "nama_dataset": "bva_data",
      "urutan": 1,
      "query_sumber_data": "SELECT a.KodeAkun, a.NamaAkun, COALESCE(b.Budget,0) AS Budget, COALESCE(r.Realisasi,0) AS Actual FROM akun a LEFT JOIN budget b ON a.KodeAkun=b.KodeAkun AND b.Tahun=@Tahun AND b.TipeBudget=@BudgetType LEFT JOIN realisasi r ON a.KodeAkun=r.KodeAkun AND r.Tahun=@Tahun ORDER BY a.KodeAkun",
      "config_json": {
        "display_role": "detail",
        "static_params": {
          "@Tahun": "2024",
          "@BudgetType": "Annual"
        },
        "calculated_fields": [
          {
            "nama_kolom": "Variance",
            "expression": "Budget - Actual",
            "format_type": "currency"
          },
          {
            "nama_kolom": "VariancePercent",
            "expression": "(Budget - Actual) / NULLIF(Budget, 0) * 100",
            "format_type": "percent"
          }
        ]
      }
    }
  ],
  
  "dbkolomlaporan": [
    {"nama_dataset": "bva_data", "nama_kolom": "KodeAkun", "label_tampil": "Kode Akun", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 1},
    {"nama_dataset": "bva_data", "nama_kolom": "NamaAkun", "label_tampil": "Nama Akun", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 2},
    {"nama_dataset": "bva_data", "nama_kolom": "Budget", "label_tampil": "Budget", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 3},
    {"nama_dataset": "bva_data", "nama_kolom": "Actual", "label_tampil": "Actual", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 4},
    {"nama_dataset": "bva_data", "nama_kolom": "Variance", "label_tampil": "Variance", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 5},
    {"nama_dataset": "bva_data", "nama_kolom": "VariancePercent", "label_tampil": "Var %", "format_type": "percent", "alignment": "right", "is_summable": false, "is_visible": true, "urutan_tampil": 6}
  ],
  
  "dbgrouplaporan": [
    {
      "id_laporan": "RPT-BVA",
      "group_level": 1,
      "group_field": "KodeAkun",
      "field_value": "account",
      "label": "Akun",
      "sort_order": 1,
      "show_subtotal": 0,
      "special_handling": "conditional-format",
      "style_config": {
        "font_weight": "normal"
      },
      "config_json": {
        "field_name": "KodeAkun",
        "conditional_formatting": {
          "Variance": {
            "rule": "absolute",
            "threshold": 1000000,
            "positive_color": "green",
            "negative_color": "red",
            "apply_to": "cell"
          },
          "VariancePercent": {
            "rule": "relative",
            "threshold": 10,
            "over_budget_color": "red",
            "under_budget_color": "green"
          }
        }
      }
    }
  ],
  
  "frontend_config": {
    "rendering_mode": "conditional-formatting",
    "show_group_headers": false,
    "show_subtotals": true,
    "show_grand_total": true,
    "conditional_formatting_enabled": true
  }
}
