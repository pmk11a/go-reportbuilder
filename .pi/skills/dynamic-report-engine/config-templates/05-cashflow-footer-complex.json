{
  "report_name": "Cash Flow dengan Footer Kompleks",
  "kode_menu": "RPT-CF-FC",
  "description": "Laporan arus kas dengan CH/GB Panel dan Summary Table di footer",
  
  "dbmasterlaporan": {
    "KODEMENU": "RPT-CF-FC",
    "nama_laporan": "Cash Flow Statement",
    "deskripsi": "Laporan arus kas dengan comparison panel dan summary",
    "status_aktif": 1,
    "footer_bands": {
      "bands": {
        "summary": {
          "footer_table": true,
          "rows": [
            {"label": "Arus Kas dari Operasi", "field": "operating_cash", "format": "currency"},
            {"label": "Arus Kas dari Investasi", "field": "investing_cash", "format": "currency"},
            {"label": "Arus Kas dari Pendanaan", "field": "financing_cash", "format": "currency"},
            {"label": "Kenaikan (Penurunan) Kas", "field": "net_cash_change", "format": "currency"},
            {"label": "Saldo Kas Awal", "field": "opening_cash", "format": "currency"},
            {"label": "Saldo Kas Akhir", "field": "closing_cash", "format": "currency", "bold": true}
          ],
          "chgb_panel": {
            "enabled": true,
            "comparison_type": "year_over_year",
            "rows": [
              {"label": "Arus Kas Operasi", "current_field": "operating_cash", "prior_field": "operating_cash_prior"},
              {"label": "Arus Kas Investasi", "current_field": "investing_cash", "prior_field": "investing_cash_prior"},
              {"label": "Arus Kas Pendanaan", "current_field": "financing_cash", "prior_field": "financing_cash_prior"},
              {"label": "Selisih", "current_field": "net_cash_change", "prior_field": "net_cash_change_prior", "highlight_diff": true}
            ]
          }
        }
      }
    }
  },
  
  "dbparameterlaporan": [
    {
      "nama_filter": "TahunLaporan",
      "label": "Tahun",
      "tipe_input": "number",
      "wajib_isi": 1,
      "nilai_default": null,
      "posisi": 1,
      "konfigurasi": null
    }
  ],
  
  "dbquerylaporan": [
    {
      "nama_dataset": "cashflow_data",
      "urutan": 1,
      "query_sumber_data": "SELECT kd_kas, nama_kas, jenis_arus, uraian, debit, kredit, saldo FROM cashflow WHERE tahun=@TahunLaporan ORDER BY jenis_arus, kd_kas",
      "config_json": {
        "display_role": "detail",
        "static_params": {
          "@TahunLaporan": "2024"
        }
      }
    }
  ],
  
  "dbkolomlaporan": [
    {"nama_dataset": "cashflow_data", "nama_kolom": "nama_kas", "label_tampil": "Kas", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 1},
    {"nama_dataset": "cashflow_data", "nama_kolom": "jenis_arus", "label_tampil": "Jenis Arus", "format_type": "text", "alignment": "center", "is_summable": false, "is_visible": true, "urutan_tampil": 2},
    {"nama_dataset": "cashflow_data", "nama_kolom": "uraian", "label_tampil": "Uraian", "format_type": "text", "alignment": "left", "is_summable": false, "is_visible": true, "urutan_tampil": 3},
    {"nama_dataset": "cashflow_data", "nama_kolom": "debit", "label_tampil": "Debit", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 4},
    {"nama_dataset": "cashflow_data", "nama_kolom": "kredit", "label_tampil": "Kredit", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 5},
    {"nama_dataset": "cashflow_data", "nama_kolom": "saldo", "label_tampil": "Saldo", "format_type": "currency", "alignment": "right", "is_summable": true, "is_visible": true, "urutan_tampil": 6}
  ],
  
  "dbgrouplaporan": [
    {
      "id_laporan": "RPT-CF-FC",
      "group_level": 1,
      "group_field": "jenis_arus",
      "field_value": "operasi",
      "label": "Arus Operasi",
      "sort_order": 1,
      "show_subtotal": 1,
      "special_handling": "default",
      "style_config": {
        "font_weight": "bold",
        "background": "blue-50"
      },
      "config_json": {
        "field_name": "jenis_arus",
        "label_mapping": {
          "OPERASI": "Arus Kas dari Operasi",
          "INVESTASI": "Arus Kas dari Investasi",
          "PENDANAAN": "Arus Kas dari Pendanaan"
        },
        "show_subtotal": true
      }
    },
    {
      "id_laporan": "RPT-CF-FC",
      "group_level": 2,
      "group_field": "kd_kas",
      "field_value": "kas",
      "label": "Kas",
      "sort_order": 2,
      "show_subtotal": 0,
      "special_handling": "default",
      "style_config": {
        "font_weight": "normal"
      },
      "config_json": {
        "field_name": "kd_kas",
        "show_subtotal": false
      }
    }
  ],
  
  "frontend_config": {
    "rendering_mode": "complex-footer",
    "show_group_headers": true,
    "show_subtotals": true,
    "footer_table_enabled": true,
    "chgb_panel_enabled": true,
    "comparison_type": "year_over_year"
  }
}
