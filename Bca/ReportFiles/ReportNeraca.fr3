<TfrxReport Version="4.14" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38793,6507510417" ReportOptions.Description.Text="" ReportOptions.LastChange="43932,3336849769" ScriptLanguage="PascalScript" ScriptText.Text="var AKTIVA,judul1,judul2:string;&#13;&#10;procedure GroupHeader2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='A1') then&#13;&#10;      judul1 := 'AKTIVA LANCAR'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='A2') then&#13;&#10;      judul1 := 'AKTIVA TETAP'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='A3') then&#13;&#10;     judul1 := 'AKTIVA LAIN-LAIN'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='P1') then&#13;&#10;      judul1 := 'KEWAJIBAN LANCAR'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='P2') then&#13;&#10;     judul1 := 'KEWAJIBAN TIDAK LANCAR'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='P3') then&#13;&#10;      judul1 := 'EKUITAS';&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure GroupHeader4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='A1') then&#13;&#10;      judul2 := 'AKTIVA LANCAR'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='A2') then&#13;&#10;      judul2 := 'AKTIVA TETAP'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='A3') then&#13;&#10;     judul2 := 'AKTIVA LAIN-LAIN'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='P1') then&#13;&#10;      judul2 := 'KEWAJIBAN LANCAR'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='P2') then&#13;&#10;     judul2 := 'KEWAJIBAN TIDAK LANCAR'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='P3') then&#13;&#10;      judul2 := 'EKUITAS';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDataset3.&#34;Jumlah2&#34;&#62;&#60;0 then&#13;&#10;  begin&#13;&#10;    Memo3.Memo.Text:='('+FormatFloat(',0.00',-1*&#60;frxDBDataset3.&#34;Jumlah2&#34;&#62;)+')'&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Memo3.Memo.Text:=FormatFloat(',0.00',&#60;frxDBDataset3.&#34;Jumlah2&#34;&#62;)&#13;&#10;  end;&#13;&#10;  if &#60;frxDBDataset3.&#34;Keterangan&#34;&#62;='' then Memo3.Memo.Text:='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDataset3.&#34;Jumlah1&#34;&#62;&#60;0 then&#13;&#10;  begin&#13;&#10;    Memo4.Memo.Text:='('+FormatFloat(',0.00',-1*&#60;frxDBDataset3.&#34;Jumlah1&#34;&#62;)+')'&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Memo4.Memo.Text:=FormatFloat(',0.00',&#60;frxDBDataset3.&#34;Jumlah1&#34;&#62;)&#13;&#10;  end;&#13;&#10;  if &#60;frxDBDataset3.&#34;Keterangan&#34;&#62;='' then Memo4.Memo.Text:='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo16OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDataset4.&#34;Jumlah2&#34;&#62;&#60;0 then&#13;&#10;  begin&#13;&#10;    Memo16.Memo.Text:='('+FormatFloat(',0.00',-1*&#60;frxDBDataset4.&#34;Jumlah2&#34;&#62;)+')'&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Memo16.Memo.Text:=FormatFloat(',0.00',&#60;frxDBDataset4.&#34;Jumlah2&#34;&#62;)&#13;&#10;  end;&#13;&#10;  if &#60;frxDBDataset4.&#34;Keterangan&#34;&#62;='' then Memo16.Memo.Text:='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo19OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDataset4.&#34;Jumlah1&#34;&#62;&#60;0 then&#13;&#10;  begin&#13;&#10;    Memo19.Memo.Text:='('+FormatFloat(',0.00',-1*&#60;frxDBDataset4.&#34;Jumlah1&#34;&#62;)+')'&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Memo19.Memo.Text:=FormatFloat(',0.00',&#60;frxDBDataset4.&#34;Jumlah1&#34;&#62;)&#13;&#10;  end;&#13;&#10;  if &#60;frxDBDataset4.&#34;Keterangan&#34;&#62;='' then Memo19.Memo.Text:='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo37OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDataset3.&#34;Divisi&#34;&#62;='01' Then&#13;&#10;     Memo37.Text :='Divisi BCA'&#13;&#10;  else&#13;&#10;  if &#60;frxDBDataset3.&#34;Divisi&#34;&#62;='02' Then      &#13;&#10;     Memo37.Text :='Divisi CA'&#13;&#10;  else Memo37.Text :='Divisi Gabungan '     ;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
