<TfrxReport Version="4.14" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38793,6507510417" ReportOptions.Description.Text="" ReportOptions.LastChange="43932,3320237037" ScriptLanguage="PascalScript" ScriptText.Text="var r1,r2,r3,p1,p2,p3:real;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; if &#60;frxDBDataset3.&#34;jumlah&#34;&#62; &#60;&#62; '' then&#13;&#10; begin&#13;&#10;  line3.visible:=true;&#13;&#10;  line4.visible:=true;&#13;&#10;  line5.visible:=true;&#13;&#10; end else&#13;&#10; begin&#13;&#10;  line3.visible:=false;&#13;&#10;  line4.visible:=false;&#13;&#10;  line5.visible:=false;&#13;&#10; end;&#13;&#10; r1:=&#60;frxDBDataset3.&#34;TotalA&#34;&#62;;&#13;&#10; r2:=&#60;frxDBDataset3.&#34;TotalB&#34;&#62;;&#13;&#10; r3:=&#60;frxDBDataset3.&#34;TotalC&#34;&#62;;&#13;&#10;&#13;&#10;if (&#60;frxDBDataset3.&#34;Perkiraan&#34;&#62;='') and (&#60;frxDBDataset3.&#34;Jumlah&#34;&#62;='')  then&#13;&#10; begin&#13;&#10;   memo8.visible:=false;   &#13;&#10;   memo19.visible:=false;  &#13;&#10;   memo30.visible:=false;  &#13;&#10;   memo11.visible:=false;  &#13;&#10;   memo25.visible:=false;  &#13;&#10;   memo20.visible:=false;  &#13;&#10;   memo26.visible:=false;  &#13;&#10;   memo4.visible:=true;  &#13;&#10;   memo5.visible:=true;  &#13;&#10;   memo13.visible:=true;  &#13;&#10;   memo16.visible:=true;  &#13;&#10;   memo21.visible:=true;  &#13;&#10;   memo24.visible:=true;  &#13;&#10;   memo28.visible:=true;&#13;&#10;&#13;&#10;   memo29.visible:=false;  &#13;&#10;   memo31.visible:=false;  &#13;&#10;   memo32.visible:=false;  &#13;&#10;   memo33.visible:=false;  &#13;&#10;   memo34.visible:=false;  &#13;&#10;   memo35.visible:=false;  &#13;&#10;   memo36.visible:=false;    &#13;&#10; end else   &#13;&#10; if (&#60;frxDBDataset3.&#34;Jumlah&#34;&#62;='T')  then&#13;&#10; begin&#13;&#10;   memo29.visible:=true;  &#13;&#10;   memo31.visible:=true;  &#13;&#10;   memo32.visible:=true;  &#13;&#10;   memo33.visible:=true;  &#13;&#10;   memo34.visible:=true;  &#13;&#10;   memo35.visible:=true;  &#13;&#10;   memo36.visible:=true;      &#13;&#10;   memo8.visible:=false;   &#13;&#10;   memo19.visible:=false;  &#13;&#10;   memo30.visible:=false;  &#13;&#10;   memo11.visible:=false;  &#13;&#10;   memo25.visible:=false;  &#13;&#10;   memo20.visible:=false;  &#13;&#10;   memo26.visible:=false;  &#13;&#10;   memo4.visible:=false;  &#13;&#10;   memo5.visible:=false;  &#13;&#10;   memo13.visible:=false;  &#13;&#10;   memo16.visible:=false;  &#13;&#10;   memo21.visible:=false;  &#13;&#10;   memo24.visible:=false;  &#13;&#10;   memo28.visible:=false;       &#13;&#10; end else&#13;&#10;  begin&#13;&#10;   memo8.visible:=true;   &#13;&#10;   memo19.visible:=true;  &#13;&#10;   memo30.visible:=true;  &#13;&#10;   memo11.visible:=true;  &#13;&#10;   memo25.visible:=true;  &#13;&#10;   memo20.visible:=true;  &#13;&#10;   memo26.visible:=true;  &#13;&#10;   memo4.visible:=false;  &#13;&#10;   memo5.visible:=false;  &#13;&#10;   memo13.visible:=false;  &#13;&#10;   memo16.visible:=false;  &#13;&#10;   memo21.visible:=false;  &#13;&#10;   memo24.visible:=false;  &#13;&#10;   memo28.visible:=false;&#13;&#10;&#13;&#10;   memo29.visible:=false;  &#13;&#10;   memo31.visible:=false;  &#13;&#10;   memo32.visible:=false;  &#13;&#10;   memo33.visible:=false;  &#13;&#10;   memo34.visible:=false;  &#13;&#10;   memo35.visible:=false;  &#13;&#10;   memo36.visible:=false;    &#13;&#10; end;&#13;&#10;   &#13;&#10;{ if p1&#60;&#62;0 then&#13;&#10; p1:=(&#60;frxDBDataset3.&#34;TotalA&#34;&#62;/&#60;frxDBDataset3.&#34;JumlahA&#34;&#62;)*100&#13;&#10; else&#13;&#10; p1:=0;&#13;&#10; if p2&#60;&#62;0 then&#13;&#10; p2:=(&#60;frxDBDataset3.&#34;TotalB&#34;&#62;/&#60;frxDBDataset3.&#34;JumlahB&#34;&#62;)*100&#13;&#10; else&#13;&#10; p2:=0;&#13;&#10; if p3&#60;&#62;0 then&#13;&#10; p3:=(&#60;frxDBDataset3.&#34;TotalC&#34;&#62;/&#60;frxDBDataset3.&#34;JumlahC&#34;&#62;)*100&#13;&#10; else&#13;&#10; p3:=0;&#13;&#10; if (&#60;frxDBDataset3.&#34;jumlah&#34;&#62; = '') and (&#60;frxDBDataset3.&#34;grup&#34;&#62; ='') and (&#60;frxDBDataset3.&#34;tipe&#34;&#62; ='') and (&#60;frxDBDataset3.&#34;tanda&#34;&#62; ='') then&#13;&#10; begin&#13;&#10;  memo19.visible:=false;&#13;&#10;  memo4.visible:=false;&#13;&#10;  memo11.visible:=false;&#13;&#10;  memo5.visible:=false;&#13;&#10;  memo20.visible:=false;&#13;&#10;  memo24.visible:=false;&#13;&#10; end else&#13;&#10; begin&#13;&#10;  memo19.visible:=true;&#13;&#10;  memo4.visible:=true;&#13;&#10;  memo11.visible:=true;&#13;&#10;  memo5.visible:=true;&#13;&#10;  memo20.visible:=true;&#13;&#10;  memo24.visible:=true;&#13;&#10; end; }&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDataset3.&#34;IsLRHPP&#34;&#62; Then&#13;&#10;     Memo1.Text :='Laporan HPP'&#13;&#10;  else&#13;&#10;     Memo1.Text :='Laporan Laba Rugi';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo37OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;frxDBDataset3.&#34;Devisi&#34;&#62;='01' Then&#13;&#10;     Memo37.Text :='Divisi BCA'&#13;&#10;  else&#13;&#10;  if &#60;frxDBDataset3.&#34;Devisi&#34;&#62;='02' Then      &#13;&#10;     Memo37.Text :='Divisi CA'&#13;&#10;  else Memo37.Text :='Divisi Gabungan '     ;  &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
