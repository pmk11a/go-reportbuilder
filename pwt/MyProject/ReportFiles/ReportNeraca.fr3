<?xml version="1.0" encoding="utf-8"?>
<TfrxReport Version="4.14" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="2047" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38793,6507510417" ReportOptions.Description.Text="" ReportOptions.LastChange="45541,877070787" ScriptLanguage="PascalScript" ScriptText.Text="var AKTIVA,judul1:string;&#13;&#10;procedure GroupHeader2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='A1') then&#13;&#10;      judul1 := 'INVESTASI'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='A2') then&#13;&#10;      judul1 := 'SELISIH PENILAIAN INVESTASI'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='A3') then&#13;&#10;     judul1 := 'ASET LANCAR DI LUAR INVESTASI'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='A4') then&#13;&#10;     judul1 := 'ASET OPERASIONAL'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='A5') then&#13;&#10;     judul1 := 'ASET LAIN-LAIN'&#13;&#10;   else       &#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='P1') then&#13;&#10;      judul1 := 'NILAI AKTUARIA'    &#13;&#10;   else       &#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='P2') then&#13;&#10;      judul1 := 'LIABILITAS DILUAR NILAI KINI AKTUARIAL'    &#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='P3') then&#13;&#10;     judul1 := 'KEWAJIBAN TIDAK LANCAR'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset3.&#34;grupAP2&#34;&#62;='P4') then&#13;&#10;      judul1 := 'MODAL SENDIRI';&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure GroupHeader4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='A1') then&#13;&#10;      judul1 := 'AKTIVA LANCAR'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='A2') then&#13;&#10;      judul1 := 'AKTIVA TETAP'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='A3') then&#13;&#10;     judul1 := 'AKTIVA LAIN-LAIN'&#13;&#10;   else                    &#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='P1') then&#13;&#10;      judul1 := 'NILAI AKTUARIA'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='P2') then&#13;&#10;     judul1 := 'LIABILITAS DILUAR NILAI KINI AKTUARIAL'&#13;&#10;   else&#13;&#10;   if (&#60;frxDBDataset4.&#34;grupAP2&#34;&#62;='P3') then&#13;&#10;      judul1 := 'MODAL SENDIRI';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo45OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   { if &#60;frxDBDataset3.&#34;Divisi&#34;&#62;='01' Then&#13;&#10;     Memo45.Text :='YAKES'&#13;&#10;  else&#13;&#10;  if &#60;frxDBDataset3.&#34;Divisi&#34;&#62;='02' Then      &#13;&#10;     Memo45.Text :='SHT'&#13;&#10;  else Memo45.Text :='Gabungan '     ; }    &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
